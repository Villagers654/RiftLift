@@ -6,7 +6,7 @@ namespace dxvk {
   DxvkFence::DxvkFence(
           DxvkDevice*           device,
     const DxvkFenceCreateInfo&  info)
-  : m_vkd(device->vkd()), m_info(info) {
+  : m_vkd(device->vkd()), m_info(info), m_lastSignalValue(info.initialValue) {
     VkSemaphoreTypeCreateInfo typeInfo = { VK_STRUCTURE_TYPE_SEMAPHORE_TYPE_CREATE_INFO };
     typeInfo.semaphoreType = VK_SEMAPHORE_TYPE_TIMELINE;
     typeInfo.initialValue = info.initialValue;
@@ -173,6 +173,25 @@ namespace dxvk {
     return value;
   }
 
+  bool DxvkFence::reserveSignal(uint64_t value) {
+    uint64_t completedValue = getValue();
+
+    std::unique_lock<dxvk::mutex> lock(m_mutex);
+    m_lastSignalValue = std::max(m_lastSignalValue, completedValue);
+
+    if (value <= m_lastSignalValue) {
+      if (!m_warnedNonIncreasingSignal) {
+        Logger::warn(str::format("Ignoring non-increasing fence signal value ",
+          value, " (current value ", m_lastSignalValue, ")"));
+        m_warnedNonIncreasingSignal = true;
+      }
+      return false;
+    }
+
+    m_lastSignalValue = value;
+    return true;
+  }
+
   HANDLE DxvkFence::sharedHandle() const {
     if (m_info.sharedType == VK_EXTERNAL_SEMAPHORE_HANDLE_TYPE_FLAG_BITS_MAX_ENUM)
       return INVALID_HANDLE_VALUE;
