# The Linux release baseline: Ubuntu 22.04 (glibc 2.35) with LLVM 20 from
# apt.llvm.org. cmake/toolchains/linux-baseline.cmake links libc++, libgcc,
# libatomic and OpenSSL statically, so the binaries need only glibc and
# desktop libraries. CI also runs the tests and the packaging in it.
#   podman build -t riftlift-baseline -f scripts/packaging/linux/Containerfile .
FROM docker.io/library/ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl gnupg \
 && curl -fsSL https://apt.llvm.org/llvm-snapshot.gpg.key | gpg --dearmor -o /usr/share/keyrings/llvm.gpg \
 && echo "deb [signed-by=/usr/share/keyrings/llvm.gpg] http://apt.llvm.org/jammy/ llvm-toolchain-jammy-20 main" \
      > /etc/apt/sources.list.d/llvm.list \
 && apt-get update && apt-get install -y --no-install-recommends \
      clang-20 lld-20 libc++-20-dev libc++abi-20-dev llvm-20 libgcc-11-dev binutils ccache \
      ninja-build pkg-config python3 python3-pip git file \
      libssl-dev libsecret-1-dev libwayland-dev libxkbcommon-dev libegl-dev libgl-dev libdbus-1-dev \
 && python3 -m pip install --no-cache-dir cmake==3.31.6 \
 && ln -s /usr/bin/clang-20 /usr/local/bin/clang && ln -s /usr/bin/clang++-20 /usr/local/bin/clang++ \
 && ln -s /usr/bin/ld.lld-20 /usr/local/bin/ld.lld && ln -s /usr/bin/llvm-strip-20 /usr/local/bin/llvm-strip \
 && rm -rf /var/lib/apt/lists/*
# libatomic is linked statically: a directory holding only the archive is
# searched before the system one (cmake/toolchains/linux-baseline.cmake), so
# -latomic resolves to libatomic.a.
RUN mkdir -p /opt/riftlift-baseline/static \
 && ln -s /usr/lib/gcc/x86_64-linux-gnu/11/libatomic.a /opt/riftlift-baseline/static/libatomic.a
