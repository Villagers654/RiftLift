#!/usr/bin/env bash
set -euo pipefail

version='@VERSION@'
release_tag='@RELEASE_TAG@'
wheel_sha256='@WHEEL_SHA256@'
runtime_sha256='@RUNTIME_SHA256@'
openvr_sha256='@OPENVR_SHA256@'
dxvk_sha256='@DXVK_SHA256@'
desktop_base64='@DESKTOP_BASE64@'
icon_base64='@ICON_BASE64@'
release_base='https://github.com/Villagers654/RiftLift/releases/download'
wheel_name="riftlift-${version}-py3-none-any.whl"
runtime_name='riftlift-compat.zip'
openvr_name='riftlift-xrizer.tar.gz'
dxvk_name='riftlift-dxvk.tar.gz'

data_home=${XDG_DATA_HOME:-$HOME/.local/share}
bin_root=${XDG_BIN_HOME:-$HOME/.local/bin}
[[ $data_home == /* ]] || data_home=$HOME/.local/share
[[ $bin_root == /* ]] || bin_root=$HOME/.local/bin
data_root=$data_home/riftlift
applications_root=$data_home/applications
icons_root=$data_home/icons/hicolor/scalable/apps
venv="$data_root/venv"
run_setup=true

if [[ ${1:-} == --no-setup ]]; then
  run_setup=false
  shift
fi
if (( $# )); then
  echo "usage: $0 [--no-setup]" >&2
  exit 2
fi

command -v python3 >/dev/null || {
  echo "Python 3.10.12 or newer is required." >&2
  exit 1
}
python3 -c 'import sys; raise SystemExit(sys.version_info < (3, 10, 12))' || {
  echo "Python 3.10.12 or newer is required." >&2
  exit 1
}
command -v git >/dev/null || {
  echo "Git is required to install RiftLift's pinned downloader dependency." >&2
  exit 1
}

temporary=$(mktemp -d "${TMPDIR:-/tmp}/riftlift-installer.XXXXXX")
previous_venv="$data_root/.venv-previous"
installing_venv=false
cleanup() {
  rm -rf -- "$temporary"
  if $installing_venv; then
    rm -rf -- "$venv"
  fi
  if $installing_venv && [[ -e $previous_venv ]]; then
    mv -- "$previous_venv" "$venv"
  fi
}
trap cleanup EXIT
wheel="$temporary/$wheel_name"

download_asset() {
  local name=$1
  local override=$2
  local target="$temporary/$name"
  local url="${release_base}/${release_tag}/${name}"
  if [[ -n $override ]]; then
    cp -- "$override" "$target"
  elif command -v curl >/dev/null; then
    curl --fail --location --retry 3 --output "$target" "$url"
  elif command -v wget >/dev/null; then
    wget --tries=3 --output-document="$target" "$url"
  else
    echo "curl or wget is required." >&2
    exit 1
  fi
}

verify_asset() {
  local target=$1
  local expected=$2
  local actual
  actual=$(python3 - "$target" <<'PY'
import hashlib
import pathlib
import sys

digest = hashlib.sha256()
with pathlib.Path(sys.argv[1]).open("rb") as stream:
    for chunk in iter(lambda: stream.read(1024 * 1024), b""):
        digest.update(chunk)
print(digest.hexdigest())
PY
)
  if [[ $actual != "$expected" ]]; then
    echo "checksum mismatch for $(basename -- "$target"); refusing to install." >&2
    exit 1
  fi
}

echo "Downloading RiftLift $version..."
download_asset "$wheel_name" "${RIFTLIFT_INSTALLER_WHEEL:-}"
verify_asset "$wheel" "$wheel_sha256"

if $run_setup; then
  runtime="$temporary/$runtime_name"
  openvr="$temporary/$openvr_name"
  dxvk="$temporary/$dxvk_name"
  download_asset "$runtime_name" "${RIFTLIFT_RUNTIME_ARCHIVE:-}"
  download_asset "$openvr_name" "${RIFTLIFT_OPENVR_RUNTIME_ARCHIVE:-}"
  download_asset "$dxvk_name" "${RIFTLIFT_DXVK_ARCHIVE:-}"
  verify_asset "$runtime" "$runtime_sha256"
  verify_asset "$openvr" "$openvr_sha256"
  verify_asset "$dxvk" "$dxvk_sha256"
fi

mkdir -p "$data_root" "$bin_root" "$applications_root" "$icons_root"
rm -rf -- "$previous_venv"
if [[ -e $venv ]]; then
  cp -a -- "$venv" "$previous_venv"
fi
installing_venv=true
python3 -m venv "$venv"
"$venv/bin/python" -m pip install --quiet --upgrade pip
"$venv/bin/python" -m pip install --quiet --upgrade "$wheel"
"$venv/bin/python" -m pip install --quiet --force-reinstall --no-deps "$wheel"
installing_venv=false
rm -rf -- "$previous_venv"
ln -sfn "$venv/bin/riftlift" "$bin_root/riftlift"
ln -sfn "$venv/bin/riftlift-gui" "$bin_root/riftlift-gui"

python3 - \
  "$applications_root/io.github.villagers654.RiftLift.desktop" \
  "$icons_root/io.github.villagers654.RiftLift.svg" \
  "$bin_root/riftlift-gui" \
  "$desktop_base64" \
  "$icon_base64" <<'PY'
import base64
import pathlib
import sys

desktop_path, icon_path, executable, desktop_payload, icon_payload = sys.argv[1:]
desktop = base64.b64decode(desktop_payload, validate=True).decode()
desktop = "\n".join(
    f'Exec="{executable}"' if line.startswith("Exec=") else line
    for line in desktop.splitlines()
) + "\n"
pathlib.Path(desktop_path).write_text(desktop)
pathlib.Path(icon_path).write_bytes(base64.b64decode(icon_payload, validate=True))
PY

if command -v update-desktop-database >/dev/null; then
  update-desktop-database "$applications_root" >/dev/null 2>&1 || true
fi

echo "Installed RiftLift $version at $bin_root/riftlift"
if $run_setup; then
  echo "Installing RiftLift's pinned Proton, Meta, OpenXR, and OpenVR components..."
  RIFTLIFT_RUNTIME_ARCHIVE="$runtime" \
    RIFTLIFT_OPENVR_RUNTIME_ARCHIVE="$openvr" \
    RIFTLIFT_DXVK_ARCHIVE="$dxvk" \
    "$bin_root/riftlift" setup
fi

cat <<EOF

RiftLift is ready.

Open RiftLift from your application menu, or run:
  $bin_root/riftlift gui

Then enable Debug logging, click System, sign in to Meta, and add a game.
EOF
